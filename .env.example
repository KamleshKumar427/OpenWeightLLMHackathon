# Copy this file to .env and fill in your own values.
#   cp .env.example .env
#   node scripts/make-config.mjs
# .env is git-ignored. Never commit real keys.

# --- University of Helsinki hackathon GPU servers (optional) ---------------------------
# Leave HACKATHON_HOST empty if you do not have access. The extension then offers only
# the public LUMI Aitta models.
HACKATHON_HOST=
HACKATHON_H200_PORT=9002
HACKATHON_A100_PORT=9001
HACKATHON_API_KEY=

# --- LUMI Aitta (optional) ----------------------------------------------------------
# Token from https://aitta-auth.csc.fi/myToken (valid 90 days, tied to a LUMI project).
# You can also just paste it into the extension's Settings panel instead.
AITTA_TOKEN=
